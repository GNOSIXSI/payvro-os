# PAYVRO OS — variable NAMES only. Never put a value in this file.
#
#
# Copy to .env.local for the Next.js side. Backend variables are NOT read from
# this file: they live in the Convex deployment (`npx convex env set NAME`,
# or the Convex dashboard). See INSTALL.md.

# ─────────────────────────────────────────────────────────────────────────────
# A. Next.js side (.env.local locally, Vercel project env when deployed)
# ─────────────────────────────────────────────────────────────────────────────

# Written by `npx convex dev`. Identifies the Convex deployment for the CLI.
CONVEX_DEPLOYMENT=

# Public URL of the Convex deployment. Written by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=

# Clerk. Required for LIVE. In DEMO both may stay empty: the app then runs
# without sign-in and the backend refuses anything that is not DEMO.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# Vercel build only: lets the build run `npx convex deploy`. Set it in the
# Vercel project, never in a local file.
CONVEX_DEPLOY_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# B. Convex deployment environment (backend). Set with `npx convex env set`.
#    Listed here only so the names are documented in one place.
# ─────────────────────────────────────────────────────────────────────────────

# `demo` or `live`. Single source of truth for the mode. Default when unset: demo.
# demo: simulator only, pey is never called. live: real pey calls.
PAYVRO_MODE=

# pey API key of THIS business (Bearer token). LIVE only. Server-side only:
# never sent to the browser, never logged, never committed.
PEY_API_KEY=

# pey id (ULID) of the registered bank account that receives the money.
# LIVE only. It is an identifier, not the CLABE. The CLABE never goes here.
PEY_BANK_ACCOUNT_ID=

# Signing secret of the pey webhook endpoint (Standard Webhooks). Optional:
# without it the webhook route answers 503 and polling plus the sweep do the work.
PEY_WEBHOOK_SECRET=

# Clerk issuer domain used by convex/auth.config.ts to validate sessions. LIVE only.
CLERK_JWT_ISSUER_DOMAIN=

# Comma-separated list of the email addresses allowed to operate this business.
# LIVE only. Anyone else who signs in gets no access. Lives only in the
# deployment environment: never in the repo, a doc or a fixture.
PAYVRO_OWNER_EMAILS=

# Public HTTPS origin of the deployed app, without trailing slash. Optional.
# Empty means local mode: the payer returns to a page served by Convex.
PAYVRO_PUBLIC_URL=
