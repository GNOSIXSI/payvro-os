{
  "name": "payvro-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/engine"
  ],
  "scripts": {
    "dev": "concurrently --kill-others \"next dev\" \"convex dev\"",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/engine/tsconfig.json && tsc --noEmit -p convex/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "next build",
    "e2e": "cross-env NEXT_PUBLIC_CONVEX_URL= NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY= npm run build && playwright install chromium && cross-env NEXT_PUBLIC_CONVEX_URL= NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY= playwright test",
    "secrets": "gitleaks dir . --redact --no-banner && gitleaks git . --log-opts=--all --redact --no-banner",
    "gate": "bash scripts/gate.sh"
  },
  "dependencies": {
    "@clerk/nextjs": "7.10.0",
    "convex": "1.50.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.7",
    "convex-test": "0.0.71",
    "cross-env": "10.1.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
